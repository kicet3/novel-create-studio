{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": [
      "node"
    ],
    "customConditions": [
      "@ncs/source"
    ]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "test-live/**/*.ts",
    "test-supabase/**/*.ts",
    "scripts/**/*.ts"
  ]
}
