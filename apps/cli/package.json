{
  "name": "@ncs/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ncs": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx --conditions=@ncs/source src/main.ts",
