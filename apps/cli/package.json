  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@ncs/db": "workspace:*",
    "@ncs/server": "workspace:*",
    "@ncs/shared": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@ncs/test-kit": "workspace:*"
  }
}
