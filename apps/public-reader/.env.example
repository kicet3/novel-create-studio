# snowpage (apps/public-reader) — Vercel 프로젝트 Settings → Environment Variables 에 넣는 이름들입니다.
# 로컬 개발은 이 파일을 .env.local 로 복사해 값을 채웁니다(.env.local 은 커밋되지 않습니다). 값은 여기 적지 마세요.

# 제한 역할(ncs_public_reader)로 Supabase Transaction pooler(포트 6543)에 접속하는 연결 문자열 (필수)
DATABASE_URL=
# DATABASE_URL 이 없을 때 대신 읽는 이름 (Vercel Supabase 연동이 만드는 변수)
POSTGRES_URL=
# 스튜디오가 동기화하는 공개 스키마 (기본 ncs_public)
DB_SCHEMA=
# 정식 주소 — canonical/og:url, CSRF Origin 검사 (기본 https://novel.snowlink.team, 로컬은 http://localhost:3000)
PUBLIC_ORIGIN=
# 운영 화면(/admin) 토큰, 24자 이상 (비우면 운영 화면 꺼짐)
ADMIN_TOKEN=
# IP 해시용 비밀, 32자 이상 (없으면 좋아요·평점·댓글 쓰기 꺼짐)
IP_HASH_SECRET=
# 쿠키 Secure 속성 (기본 true; http://localhost 개발에서만 false)
COOKIE_SECURE=
# 쉼표로 구분한 금칙어 — 포함된 댓글은 숨김(검토 대기)
BANNED_WORDS=
# true 면 https://*.vercel.app 미리보기 배포의 요청도 허용 (기본 false)
ALLOW_PREVIEW_ORIGINS=
