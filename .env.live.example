# 운영(라이브)용 환경 변수 예제 (빌드본: node apps/server/dist/main.js)
# 사용: cp .env.live.example .env.live  → 값 채우기. `.env.live`는 git에 올라가지 않습니다.
# 실행: pnpm build && node --env-file=.env.live apps/server/dist/main.js

# 운영 모드: OAuth/구독 로그인은 꺼지고 API 키만 씁니다.
NCS_DEV_MODE=0

# 설치 홈(DB·비밀·백업)
NCS_HOME=~/.ncs

# 서버 — 예: Tailscale IP로만 노출
NCS_HOST=100.x.y.z
NCS_PORT=3100
NCS_DEPLOYMENT_MODE=local_trusted
NCS_EXPOSURE=private
# Host 헤더 허용 목록 (MagicDNS 이름 등, 쉼표 구분)
NCS_ALLOWED_HOSTNAMES=your-machine.your-tailnet.ts.net,your-machine

# --- 데이터베이스: Supabase Postgres (README "Supabase 사용") ---
# Supabase 대시보드 → 프로젝트 → Connect 에서 주소를 복사합니다. 비밀번호의 특수 문자는 퍼센트 인코딩하세요.
# Session pooler (IPv4, 사용자 postgres.<project-ref>, 포트 5432) — 대부분의 네트워크에서 권장
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Direct connection (IPv6 — IPv4 애드온이 없으면 IPv6 네트워크 필요)
# DATABASE_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
# 트랜잭션 풀러(포트 6543)는 쓸 수 없습니다(서버가 시작을 거부합니다).
# 호스트가 *.supabase.co / *.supabase.com 이면 자동 인식. 그 밖(프록시·로컬 supabase start)은 명시:
# NCS_DB_PROVIDER=supabase
# 앱 전용 스키마. 모든 앱 테이블·함수·app_migrations 가 여기에만 생깁니다. Supabase "Exposed schemas"에 넣지 마세요.
NCS_DB_SCHEMA=ncs
# 연결 풀 크기 (Supabase 기본 5). 서버는 이 외에 instance_lock 용 연결 1개를 더 씁니다.
NCS_DB_POOL_MAX=5
# TLS: 기본 sslmode=require. 서버 인증서까지 검증하려면 대시보드 Database Settings 의 CA 인증서 경로(verify-full)
# NCS_DB_SSL_CA_FILE=/path/to/prod-ca-2021.crt
# btree_gist / pg_trgm 이 없을 때 만들 스키마 (Supabase 기본 extensions)
# NCS_DB_EXTENSIONS_SCHEMA=extensions

# 내장 PostgreSQL 을 쓰려면 DATABASE_URL 을 지우세요 (포트 기본 54329)
# NCS_PG_PORT=54329

NCS_LOG_LEVEL=info

# 비밀 암호화 마스터 키 (base64 32바이트). 비우면 $NCS_HOME/secrets/master.key 파일을 씁니다.
# 새로 만들기: openssl rand -base64 32
NCS_SECRETS_MASTER_KEY=
# NCS_SECRETS_MASTER_KEY_FILE=

# --- LLM (운영은 API 키 필수) ---
NCS_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# 선택 공급자
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
