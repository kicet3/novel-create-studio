# 개발용 환경 변수 예제 (pnpm dev)
# 사용: cp .env.dev.example .env.dev  → 값 채우기. `.env.dev`는 git에 올라가지 않습니다.
# 우선순위: CLI 플래그 > 환경 변수 > ~/.ncs/config.json > 기본값

# 개발 모드: Claude 구독(claude -p), ChatGPT 로그인, xAI 기기 코드 로그인 같은 OAuth 방식이 켜집니다.
NCS_DEV_MODE=1

# 설치 홈(DB·비밀·백업). 운영 데이터와 섞이지 않게 별도 경로를 권장합니다.
NCS_HOME=~/.ncs-dev

# 서버 (로컬 전용)
NCS_HOST=127.0.0.1
NCS_PORT=3100
NCS_DEPLOYMENT_MODE=local_trusted
NCS_EXPOSURE=private
# NCS_ALLOWED_HOSTNAMES=

# 내장 PostgreSQL 포트 (운영과 다르게)
NCS_PG_PORT=54339
# 외부 DB를 쓰려면: DATABASE_URL=postgres://user:pass@localhost:5432/ncs_dev

# --- (선택) Supabase 로 개발 — 기본은 위의 내장 PostgreSQL 입니다 ---
# 운영 프로젝트와 다른 스키마(또는 다른 프로젝트)를 쓰세요. 트랜잭션 풀러(6543)는 쓸 수 없습니다.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# NCS_DB_SCHEMA=ncs_dev
# NCS_DB_POOL_MAX=3
# 로컬 스택(`npx supabase start`, TLS 없음): 호스트로 인식되지 않으므로 공급자를 명시하고 sslmode=disable
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable
# NCS_DB_PROVIDER=supabase

# 로그
NCS_LOG_LEVEL=debug
NCS_LOG_PRETTY=1

# --- LLM ---
# 비워 두면 자동 선택: API 키가 없고 Claude Code CLI가 claude.ai 구독으로 로그인되어 있으면 Claude 구독을 씁니다.
# NCS_LLM_PROVIDER=anthropic
# Claude 구독: 터미널에서 직접 `claude auth login` 하세요. 앱은 로그인 정보를 읽거나 저장하지 않습니다.
# NCS_CLAUDE_PATH=claude
# NCS_CLAUDE_MAX_CONCURRENT=2

# API 키 (선택). 설정 화면에서 넣으면 암호화해 저장되므로 여기 적지 않아도 됩니다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# pnpm test:live 의 Claude API 레인 모델 (기본 claude-haiku-5-5)
# NCS_LIVE_MODEL=claude-haiku-5-5

# --- OpenTelemetry 로그 (선택) ---
# OTLP 엔드포인트를 넣으면 stdout JSON 로그와 같은 내용(비밀 값은 가려진 상태)을 OpenTelemetry 로그로도 보냅니다.
# 로컬 수집 스택: ~/.ncs/otel/docker-compose.yml (grafana/otel-lgtm — Grafana http://127.0.0.1:3300, Explore → Loki → {service_name="ncs-server"})
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=ncs-server
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev
