{
  "name": "@ncs/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@ncs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "@ncs/source": "./src/schema/index.ts",
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./orm": {
      "@ncs/source": "./src/orm.ts",
      "types": "./dist/orm.d.ts",
      "default": "./dist/orm.js"
    },
    "./testing": {
      "@ncs/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node ./scripts/copy-migrations.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run --project db",
    "check-embedded": "tsx --conditions=@ncs/source ./scripts/check-embedded.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@ncs/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "embedded-postgres": "18.4.0-beta.17",
    "postgres": "^3.4.9"
  }
}
